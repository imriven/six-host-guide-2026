{
  "name": "six-host-guide-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "data:build": "python3 scripts/xlsx_to_json.py",
    "data:check": "python3 scripts/xlsx_to_json.py --check",
    "documents:build": "python3 scripts/build_ros_docx.py && python3 scripts/build_ros_pdf_only.py",
    "test:data": "python3 -m unittest discover -s scripts -p test_*.py -v",
    "check": "npm run data:check && npm run test:data && tsc -b",
    "dev": "npm run data:build && vite",
    "build": "npm run data:build && npm run test:data && tsc -b && npm run documents:build && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.2.2",
    "typescript": "7.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
}
