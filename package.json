{
  "name": "six-host-guide-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "data:build": "python scripts/xlsx_to_json.py",
    "data:check": "python scripts/xlsx_to_json.py --check",
    "test:data": "python -m unittest discover -s scripts -p test_*.py -v",
    "check": "npm run data:check && npm run test:data && tsc -b",
    "dev": "npm run data:build && vite",
    "build": "npm run data:build && npm run test:data && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
